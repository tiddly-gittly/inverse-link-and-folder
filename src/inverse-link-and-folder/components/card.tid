title: $:/plugins/linonetwo/inverse-link-and-folder/components/card

\procedure lingo-base() $:/plugins/linonetwo/inverse-link-and-folder/language/

\procedure inverse-link-and-folder-card(filter,lingoKey)
\whitespace trim
  <%if [subfilter<filter>] -[is[current]] +[limit[1]] %>
    <li class="inverse-link-and-folder-card-sub-title"><strong><$transclude $variable="lingo" title=<<lingoKey>>/></strong></li>
    <$list filter=<<filter>>>
      <li class="inverse-link-and-folder-card-reference">
        <%if [[$:/plugins/linonetwo/inverse-link-and-folder/configs/hover-to-show]text[yes]] %>
          <$eventcatcher $mouseover="""<$action-setfield $tiddler={{{ [[$:/state/inverse-link-and-folder/hover-item/]addsuffix<currentTiddler>] }}} text="yes"/>""" stopPropagation="never" tag="div">
            <$link>
              <b>
                <$transclude field="caption">
                  <$view field="title"/>
                </$transclude>
              </b>
              <$reveal state={{{ [[$:/state/inverse-link-and-folder/hover-item/]addsuffix<currentTiddler>] }}} type="match" text="yes">
                <div class="inverse-link-and-folder-card-content">
                  <$transclude field="text" mode="inline" />
                </div>
              </$reveal>
              <$reveal state={{{ [[$:/state/inverse-link-and-folder/hover-item/]addsuffix<currentTiddler>] }}} type="nomatch" text="yes">
                <div class="inverse-link-and-folder-card-content">
                  <span>&nbsp;</span>
                </div>
              </$reveal>
            </$link>
          </$eventcatcher>
        <%else%>
          <$link>
            <b>
              <$transclude field="caption">
                <$view field="title"/>
              </$transclude>
            </b>
            <div class="inverse-link-and-folder-card-content">
              <$transclude field="text" mode="inline" />
            </div>
          </$link>
        <%endif%>
      </li>
    </$list>
  <%endif%>
\end
